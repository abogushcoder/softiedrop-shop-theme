{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title",
          "settings": {}
        },
        "softie_facts": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"softie-facts\">{% render 'texture-badge', product: product %}{% if product.metafields.softie.size_cm != blank %}<span class=\"softie-texture softie-texture--gel\">{{ product.metafields.softie.size_cm.value }} cm</span>{% endif %}</div>"
          }
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "inventory": {
          "type": "inventory",
          "settings": {
            "text_style": "body",
            "inventory_threshold": 5,
            "show_inventory_quantity": true
          }
        },
        "softie_meter": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'squish-meter', product: product %}"
          }
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "softie_safety": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% if product.metafields.softie.safety_note != blank %}<p class=\"softie-safety\">{{ product.metafields.softie.safety_note.value | escape }}</p>{% endif %}"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "settings": {}
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false
          }
        },
        "softie_live_link": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% if settings.softie_tiktok_url != blank %}<p><a class=\"softie-live-link\" href=\"{{ settings.softie_tiktok_url }}\" target=\"_blank\" rel=\"noopener\">See it squished on a live</a></p>{% endif %}"
          }
        }
      },
      "block_order": [
        "title",
        "softie_facts",
        "price",
        "inventory",
        "softie_meter",
        "description",
        "softie_safety",
        "quantity_selector",
        "buy_buttons",
        "softie_live_link"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail_slider",
        "media_size": "medium",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "More squishies",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "related-products"
  ]
}