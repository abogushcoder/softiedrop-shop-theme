{%- comment -%}
  softie: the newest designs in the store (8 by default), newest first. No collection to maintain.
{%- endcomment -%}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{%- if section.settings.quick_add == 'standard' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign newest = collections.all.products | sort: 'created_at' | reverse
  assign shown = section.settings.count
-%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding softie-newest" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
    <div class="softie-newest__head">
      <h2 class="h1">{{ section.settings.heading | escape }}</h2>
      <a class="link underlined-link" href="{{ routes.all_products_collection_url }}">Shop all</a>
    </div>
    {%- if newest.size > 0 -%}
      <ul class="grid product-grid contains-card--product grid--2-col-tablet-down grid--4-col-desktop" role="list">
        {%- for product in newest limit: shown -%}
          <li class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
            {% render 'card-product',
              card_product: product,
              media_aspect_ratio: 'square',
              image_shape: 'default',
              lazy_load: true,
              show_secondary_image: true,
              show_vendor: false,
              show_rating: false,
              section_id: section.id,
              quick_add: section.settings.quick_add
            %}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p>New squishies are on the way. Catch a live on TikTok to see them first.</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Newest squishies",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Newest squishies" },
    { "type": "range", "id": "count", "label": "Designs to show", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "select", "id": "quick_add", "label": "Quick add", "options": [{ "value": "none", "label": "Off" }, { "value": "standard", "label": "On" }], "default": "standard" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 }
  ],
  "presets": [{ "name": "Newest squishies" }]
}
{% endschema %}
