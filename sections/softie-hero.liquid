{%- comment -%}
  softie: short home hero. Headline, one line of text, Shop all button and a static row of jelly blobs
  (no physics canvas in the store, so product pages stay fast).
{%- endcomment -%}
<section class="softie-hero color-{{ section.settings.color_scheme }} gradient">
  <h2 class="softie-hero__title">{{ section.settings.heading | escape }}</h2>
  {%- if section.settings.text != blank -%}
    <p class="softie-hero__text">{{ section.settings.text | escape }}</p>
  {%- endif -%}
  {%- if section.settings.button_label != blank -%}
    <a class="button button--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
      {{- section.settings.button_label | escape -}}
    </a>
  {%- endif -%}
  {%- if section.settings.show_blobs -%}
    <div class="softie-hero__blobs" aria-hidden="true">
      {%- comment -%} blob {%- endcomment -%}
      <svg viewBox="0 0 120 92" focusable="false"><ellipse cx="60" cy="88" rx="42" ry="4" fill="#3B1E2B" opacity=".12"/><path d="M14 66C14 30 34 12 60 12s46 18 46 54c0 10-6 12-14 12H28c-8 0-14-2-14-12z" fill="#FF8DA6"/><ellipse cx="44" cy="28" rx="11" ry="6" fill="#fff" opacity=".55" transform="rotate(-25 44 28)"/><circle cx="46" cy="50" r="4.5" fill="#3B1E2B"/><circle cx="74" cy="50" r="4.5" fill="#3B1E2B"/><path d="M54 58q6 5 12 0" stroke="#3B1E2B" stroke-width="3" fill="none" stroke-linecap="round"/></svg>
      {%- comment -%} mochi {%- endcomment -%}
      <svg viewBox="0 0 120 92" focusable="false"><ellipse cx="60" cy="88" rx="44" ry="4" fill="#3B1E2B" opacity=".12"/><ellipse cx="60" cy="56" rx="50" ry="30" fill="#CDB8FF"/><ellipse cx="38" cy="40" rx="10" ry="5" fill="#fff" opacity=".55" transform="rotate(-20 38 40)"/><circle cx="48" cy="56" r="4.5" fill="#3B1E2B"/><circle cx="72" cy="56" r="4.5" fill="#3B1E2B"/><ellipse cx="38" cy="64" rx="6" ry="3.5" fill="#F2557A" opacity=".4"/><ellipse cx="82" cy="64" rx="6" ry="3.5" fill="#F2557A" opacity=".4"/><path d="M55 63q5 4 10 0" stroke="#3B1E2B" stroke-width="3" fill="none" stroke-linecap="round"/></svg>
      {%- comment -%} kitty {%- endcomment -%}
      <svg viewBox="0 0 120 92" focusable="false"><ellipse cx="60" cy="88" rx="40" ry="4" fill="#3B1E2B" opacity=".12"/><path d="M28 34 32 8 52 24ZM92 34 88 8 68 24Z" fill="#FFD66B" stroke="#FFD66B" stroke-width="6" stroke-linejoin="round"/><ellipse cx="60" cy="52" rx="42" ry="34" fill="#FFD66B"/><circle cx="47" cy="50" r="4.5" fill="#3B1E2B"/><circle cx="73" cy="50" r="4.5" fill="#3B1E2B"/><path d="M54 59q6 5 12 0" stroke="#3B1E2B" stroke-width="3" fill="none" stroke-linecap="round"/></svg>
      {%- comment -%} peach {%- endcomment -%}
      <svg viewBox="0 0 120 92" focusable="false"><ellipse cx="60" cy="88" rx="38" ry="4" fill="#3B1E2B" opacity=".12"/><circle cx="60" cy="52" r="36" fill="#FFB18F"/><ellipse cx="68" cy="16" rx="13" ry="6" fill="#7BC67E" transform="rotate(-25 68 16)"/><circle cx="48" cy="52" r="4.5" fill="#3B1E2B"/><circle cx="72" cy="52" r="4.5" fill="#3B1E2B"/><path d="M55 60q5 4 10 0" stroke="#3B1E2B" stroke-width="3" fill="none" stroke-linecap="round"/></svg>
      {%- comment -%} bao {%- endcomment -%}
      <svg viewBox="0 0 120 92" focusable="false"><ellipse cx="60" cy="88" rx="44" ry="4" fill="#3B1E2B" opacity=".12"/><path d="M10 70C10 38 32 22 60 22s50 16 50 48c0 8-6 10-14 10H24c-8 0-14-2-14-10z" fill="#FFF3DF" stroke="#E9D8BD" stroke-width="2"/><path d="M60 26q-6 6-10 14M60 26q0 8 0 14M60 26q6 6 10 14" stroke="#C8966E" stroke-width="2.5" fill="none" stroke-linecap="round" opacity=".6"/><circle cx="47" cy="58" r="4.5" fill="#3B1E2B"/><circle cx="73" cy="58" r="4.5" fill="#3B1E2B"/><path d="M55 66q5 4 10 0" stroke="#3B1E2B" stroke-width="3" fill="none" stroke-linecap="round"/></svg>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Softie hero",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Squishies you can keep squeezing"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Every design is squeezed on our TikTok lives first. Grab the ones you loved here."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "show_blobs",
      "label": "Show the row of jelly blobs",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Softie hero"
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  }
}
{% endschema %}
