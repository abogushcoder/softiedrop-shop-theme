{%- comment -%}
  softie: hidden-mode page shown while Shopify's storefront password is on.
  Logo, "opening soon" message, the live-alerts signup (same as softiedrop.com),
  the TikTok follow button, and a small "Have the password?" form for testers.
{%- endcomment -%}
<div class="softie-soon color-{{ section.settings.color_scheme }} gradient">
  <div class="softie-soon__in">
    <a href="{{ settings.softie_main_site_url | default: routes.root_url }}" aria-label="Softie Drop home">{%- render 'softie-logo' -%}</a>
    <h1 class="softie-soon__title">{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.text != blank -%}
      <p class="softie-soon__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}
    {%- if settings.softie_tiktok_url != blank -%}
      <a class="softie-pill softie-pill--plum" href="{{ settings.softie_tiktok_url }}" target="_blank" rel="noopener">Follow on TikTok</a>
    {%- endif -%}

    {%- if section.settings.show_signup -%}
      <div class="softie-signup__box">
        <h2 class="softie-signup__title h2">{{ section.settings.signup_heading | escape }}</h2>
        {%- render 'live-alerts-form', id: section.id -%}
      </div>
    {%- endif -%}

    <details class="softie-soon__pw">
      <summary>Have the password?</summary>
      {%- form 'storefront_password', class: 'softie-form' -%}
        <label class="softie-visually-hidden" for="SoftiePassword">Store password</label>
        <input
          type="password"
          name="password"
          id="SoftiePassword"
          autocomplete="current-password"
          placeholder="Store password"
          {% if form.errors %}aria-invalid="true" aria-describedby="SoftiePasswordError"{% endif %}
        >
        <button name="commit" class="button button--secondary">Enter</button>
        {%- if form.errors -%}
          <p id="SoftiePasswordError" class="softie-form__msg err" role="status">That password didn't work. Check it and try again.</p>
          <script>document.currentScript.closest('details').open = true;</script>
        {%- endif -%}
      {%- endform -%}
    </details>
  </div>
</div>

{% schema %}
{
  "name": "Softie opening soon",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Softie Drop shop is opening soon"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Until then, catch every squishy on our TikTok lives."
    },
    {
      "type": "checkbox",
      "id": "show_signup",
      "label": "Show live-alerts signup",
      "default": true
    },
    {
      "type": "text",
      "id": "signup_heading",
      "label": "Signup heading",
      "default": "Get live alerts"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "enabled_on": {
    "templates": [
      "password"
    ]
  },
  "presets": [
    {
      "name": "Softie opening soon"
    }
  ]
}
{% endschema %}
