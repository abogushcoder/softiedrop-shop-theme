{%- comment -%}
  softie: "Get live alerts" signup block, the same form as softiedrop.com.
{%- endcomment -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width softie-signup" id="alerts" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
    <div class="softie-signup__box">
      <h2 class="softie-signup__title h1">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="softie-signup__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- render 'live-alerts-form', id: section.id -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Live alerts signup",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get live alerts" },
    { "type": "text", "id": "text", "label": "Text", "default": "Get a heads-up before we go live, plus a first look at new squishies." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [{ "name": "Live alerts signup" }]
}
{% endschema %}
